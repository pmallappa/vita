%% Start of file `cv-layout.sty'.
% Page layout configuration for Awesome CV
%
% This file contains page geometry and header/footer setup

\ProvidesPackage{cv-layout}[2025/11/28 v2.0 Awesome CV Layout Package]

%-------------------------------------------------------------------------------
%                Configuration for layout
%-------------------------------------------------------------------------------
%% Page Layout
% Configure page margins with geometry (more space on right for margin notes)
\geometry{left=2.0cm, top=1.5cm, right=2.0cm, bottom=2.0cm, footskip=.5cm}
\newcommand{\acvSidebarRightMargin}{4.6cm}
\newcommand{\acvSidebarMarginWidth}{4.1cm}
\newcommand{\acvSidebarFooterOffset}{2.6cm}

% Switch from the full-width first page to the sidebar layout used by sections
% that carry margin notes on subsequent pages.
\newcommand{\acvsidebarlayout}{%
  \newgeometry{left=2.0cm, top=1.5cm, right=\acvSidebarRightMargin, bottom=2.0cm, footskip=.5cm, marginparwidth=\acvSidebarMarginWidth}%
  \fancyhfoffset[R]{\acvSidebarFooterOffset}%
}
\newcommand{\acvsidebarpagebreak}{%
  \acvsidebarlayout%
  \clearpage%
}

%% Header & Footer
% Set offset to each header and footer to extend into margin area on both sides
\fancyhfoffset[L]{0cm}
\fancyhfoffset[R]{0cm}
% Remove head rule
\renewcommand{\headrulewidth}{0pt}
% Clear all header & footer fields
\fancyhf{}
% Enable if you want to make header or footer using fancyhdr
\pagestyle{fancy}

\endinput
%% End of file `cv-layout.sty'.
