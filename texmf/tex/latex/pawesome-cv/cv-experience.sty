%% Start of file `cv-experience.sty'.
% Experience-specific commands for Awesome CV
%
% This file contains commands for the experience section with employer/role hierarchy

\ProvidesPackage{cv-experience}[2025/11/28 v2.0 Awesome CV Experience Package]

\newif\ifacvFirstEmployer

%-------------------------------------------------------------------------------
%                Commands for Experience Section
%-------------------------------------------------------------------------------
% Reset the first-employer flag at the start of a cventries block
\let\acvOrigCventries\cventries
\let\acvOrigEndCventries\endcventries
\renewenvironment{cventries}{%
  \global\acvFirstEmployertrue
  \acvOrigCventries
}{%
  \acvOrigEndCventries
}

% Experience employer header - displays company name with date/location in right margin
% Usage: \experienceemployer{<company name>}{<start date>}{<end date>}{<location>}
\newcommand*{\experienceemployer}[4]{%
  \ifacvFirstEmployer
    \par\addvspace{\acvExpFirstEmployerSkip}%
    \global\acvFirstEmployerfalse
  \else
    \par\addvspace{\acvExpBetweenEmployerSkip}%
  \fi
  \Needspace{8\baselineskip}
  \setlength\tabcolsep{0pt}
  \setlength{\extrarowheight}{0pt}
  \noindent\begin{tabular*}{\dimexpr\textwidth+\marginparsep+\marginparwidth\relax}{@{}L{\textwidth}@{\hspace{\marginparsep}}L{\marginparwidth}@{}}
    \exptitlestyle{#1} &
    \smash{\raisebox{0pt}[0pt][0pt]{%
    \ifx&#4&%
      \companydatestyle{#2 -- #3}%
    \else
      \begin{tabular}[t]{@{}l@{}}
        \companydatestyle{#2 -- #3}\\[0.6pt]
        \explocationstyle{#4}
      \end{tabular}%
    \fi}} \\[-5mm]
  \end{tabular*}%
}

% Experience role - displays role title
% Usage: \experiencerole{<role title>}
\newcommand*{\experiencerole}[1]{%
  \vspace{\acvExpEmployerToRoleSkip}
  \Needspace{6\baselineskip}%
  \global\acvAfterRoleHeadertrue
  \setlength\tabcolsep{0pt}
  \noindent
  \begin{tabular*}{\textwidth}{@{\extracolsep{\fill}} L{0.7\textwidth} R{0.3\textwidth}}
    {\exppositionstyle{#1}} &
  \end{tabular*}%
  \vspace{\acvExpRoleToContentSkip}
}

% Experience entry - displays description items
% Usage: \experienceentry{<description>}
\newcommand*{\experienceentry}[1]{%
  \setlength\tabcolsep{0pt}
  \setlength{\extrarowheight}{0pt}
  \expdescriptionstyle{#1}
  \par\vspace{\acvExpAfterContentSkip}
}

% Experience content environment - ensures consistent font/spacing for role details
\newenvironment{experiencecontent}{%
  \vspace{\acvExpRoleToContentSkip}
  \begingroup
  \fontsize{9pt}{13pt}\bodyfontlight\color{text}\selectfont
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0.6mm}%
  \setlength{\leftskip}{0pt}%
  \setlength{\rightskip}{3pt plus 0.5em}%
  \tolerance=1000%
  \emergencystretch=1em%
  \justifying
}{%
  \par
  \endgroup
  \vspace{\acvExpAfterContentSkip}
}

\endinput
%% End of file `cv-experience.sty'.
