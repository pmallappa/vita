%% Start of file `cv-header-footer.sty'.
% Header and footer commands for Awesome CV
%
% Minimal version - only essential commands

\ProvidesPackage{cv-header-footer}[2025/11/28 v2.0 Awesome CV Header/Footer Package]

%-------------------------------------------------------------------------------
%                Commands for header and footer
%-------------------------------------------------------------------------------
% Define a header for CV
% Usage: \makecvheader
\newcommand*{\makecvheader}[1][C]{%
  % Left column: name, position, address (~65% width)
  \begin{minipage}[t]{0.62\textwidth}%
    \raggedright%
    \headerfirstnamestyle{\@firstname}\headerlastnamestyle{{}\acvHeaderNameDelim\@lastname}%
    \\[\acvHeaderAfterNameSkip]%
    \ifthenelse{\isundefined{\@position}}{}{\headerpositionstyle{\@position\\[\acvHeaderAfterPositionSkip]}}%
    \ifthenelse{\isundefined{\@address}}{}{\headeraddressstyle{\@address}}%
  \end{minipage}%
  \hfill%
  % Right column: contact items stacked vertically (~35% width, right-aligned)
  \begin{minipage}[t]{0.36\textwidth}%
    \raggedleft%
    \headersocialstyle{%
      \ifthenelse{\isundefined{\@mobile}}{}{\faIcon{mobile-alt}\acvHeaderIconSep\@mobile\\[1pt]}%
      \ifthenelse{\isundefined{\@email}}{}{\href{mailto:\@email}{\mbox{\faIcon{envelope}\acvHeaderIconSep\@email}}\\[1pt]}%
      \ifthenelse{\isundefined{\@homepage}}{}{\href{http://\@homepage}{\mbox{\faIcon{home}\acvHeaderIconSep\@homepage}}\\[1pt]}%
      \ifthenelse{\isundefined{\@github}}{}{\href{https://github.com/\@github}{\mbox{\faIcon{github}\acvHeaderIconSep\@github}}\\[1pt]}%
      \ifthenelse{\isundefined{\@linkedin}}{}{\href{https://www.linkedin.com/in/\@linkedin}{\mbox{\faIcon{linkedin}\acvHeaderIconSep\@linkedin}}}%
    }%
  \end{minipage}%
  \par\vspace{\acvHeaderAfterSocialSkip}%
  \ifthenelse{\isundefined{\@quote}}{}{\headerquotestyle{\@quote\\}\vspace{\acvHeaderAfterQuoteSkip}}%
}

% Define a footer for CV
% Usage: \makecvfooter{<left>}{<center>}{<right>}
\newcommand*{\makecvfooter}[3]{%
  \fancyfoot{}
  \fancyfoot[L]{\footerstyle{#1}}
  \fancyfoot[C]{\footerstyle{#2}}
  \fancyfoot[R]{\footerstyle{#3}}
}

\endinput
%% End of file `cv-header-footer.sty'.
